# CRM System backend configuration template.
#
# Copy this file to `.env` in the backend directory and adjust values:
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# The backend reads this file when started from the backend directory
# (see app/config.py, env_file = ".env").

# MySQL connection string.
# Host/port/user/password/database must match your local MySQL setup
# (see db_init.sql at the project root).
DATABASE_URL=mysql+pymysql://crm:crm123@localhost:3306/crm?charset=utf8mb4

# JWT signing secret - MUST be changed to a long random string in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
